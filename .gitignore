.venv/
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/
# build artifacts — `python -m build` / `uv build`, as the wheel CI job runs (M20)
build/
dist/
# generated graph artifacts (v1: generated on-demand, not committed — DESIGN §10.9)
graph.json
*.graph.json
*.meta.json
# raw external inputs (Telegram exports, etc.) — never committed; processed into
# research/ with personal info stripped instead.
assets/
# credentials — never committed; real keys live outside the repository entirely.
# A rule here is only a backstop: `git add -f` defeats it, a path outside the worktree does not.
.env
.env.*
!.env.example
*.pem
*.key
